{"id": 31, "name": "read", "category": "tool_schema", "project": "default", "contract": "completion", "surface": "tools", "min_calls": 1, "prompt": "Read the file src/index.ts and tell me the marker value.", "checks": [{"type": "any_tool_name", "equals": "read"}, {"type": "max_tool_count", "max": 1, "description": "exactly one tool call"}, {"type": "any_tool_param_exists", "tool": "read", "param": "filePath"}, {"type": "any_tool_param_absent", "tool": "read", "param": "path"}, {"type": "text_contains", "pattern": "8f3a2b1c", "description": "response mentions the marker"}]}
