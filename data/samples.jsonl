{"id": 1, "name": "camel_case", "category": "agents_md", "project": "camel_case", "contract": "completion", "surface": "agents", "min_calls": 2, "prompt": "Write a function that converts Fahrenheit to Celsius. Write it to src/convert.py", "checks": [{"type": "file_regex", "path": "src/convert.py", "pattern": "def\\s+[a-z]+[A-Z]\\w*\\(", "should_match": true, "description": "function name is camelCase (e.g. fahrenheitToCelsius)"}, {"type": "file_regex", "path": "src/convert.py", "pattern": "def\\s+[a-z]+_[a-z]", "should_match": false, "description": "no snake_case function names"}, {"type": "file_regex", "path": "src/convert.py", "pattern": "return.*\\(.*-\\s*32\\)", "should_match": true, "description": "function body contains F-to-C conversion formula (f - 32)"}, {"type": "tool_before", "first": "read", "then": "edit", "description": "read before edit (filetime.assert enforced)"}]}
{"id": 2, "name": "custom_main_agent", "category": "agents_md", "project": "custom_main_agent", "contract": "routing", "surface": "agents", "agent": "auditor", "min_calls": 1, "prompt": "Review src/app.ts for security issues.", "checks": [{"type": "any_tool_name", "equals": "read"}, {"type": "text_contains", "pattern": "\\[AUDITOR\\]", "description": "response has [AUDITOR] prefix from custom agent prompt"}]}
{"id": 3, "name": "focused_read", "category": "distractor", "project": "default", "contract": "completion", "surface": "tools", "min_calls": 1, "prompt": "This project has src/auth.ts, src/utils.ts, src/index.ts, and their test files. I only need the marker value from index.ts -- nothing else.", "checks": [{"type": "any_tool_name", "equals": "read"}, {"type": "text_contains", "pattern": "8f3a2b1c", "description": "reports the correct marker"}, {"type": "max_tool_count", "max": 2, "description": "uses at most 2 tool calls"}, {"type": "no_tool_name", "not_equals": "grep"}, {"type": "no_tool_name", "not_equals": "task"}]}
{"id": 4, "name": "verbose_context", "category": "distractor", "project": "default", "contract": "completion", "surface": "tools", "min_calls": 1, "prompt": "This is a TypeScript project with an authentication module in src/auth.ts that handles token verification via a verify function, a utilities module in src/utils.ts with shared constants including TOKEN, test files for both modules, and an entry point at src/index.ts that exports a version string. I just need the version string from the entry point.", "checks": [{"type": "any_tool_name", "equals": "read"}, {"type": "text_contains", "pattern": "1\\.0\\.0", "description": "reports the correct version string"}, {"type": "max_tool_count", "max": 2, "description": "uses at most 2 tool calls"}, {"type": "no_tool_name", "not_equals": "grep"}, {"type": "no_tool_name", "not_equals": "task"}]}
{"id": 5, "name": "wrong_lead", "category": "distractor", "project": "default", "contract": "completion", "surface": "tools", "min_calls": 1, "prompt": "The verify function in src/auth.ts is returning false for valid inputs. I've looked at the logic and the comparison seems fine. Maybe the TOKEN value in src/utils.ts changed? Before I dig into auth.ts further, what is TOKEN currently set to?", "checks": [{"type": "any_tool_name", "equals": "read"}, {"type": "any_tool_param_regex", "tool": "read", "param": "filePath", "pattern": "utils", "description": "reads utils.ts, not auth.ts"}, {"type": "text_contains", "pattern": "abc123", "description": "reports the TOKEN value"}, {"type": "max_tool_count", "max": 2, "description": "uses at most 2 tool calls"}, {"type": "no_tool_name", "not_equals": "grep"}]}
{"id": 6, "name": "batch_edit", "category": "efficiency", "project": "default", "contract": "completion", "surface": "tools", "min_calls": 3, "prompt": "In src/auth.ts, make two changes: (1) replace `// NEEDLE_f9c2` with `// NEEDLE_updated`, and (2) replace `// MARKER: b7e1d930` with `// MARKER: updated`. Both old strings are exact -- do it as concisely as possible.", "checks": [{"type": "max_tool_count", "max": 3, "description": "at most 3 tool calls"}, {"type": "tool_count_score", "optimal": 3, "limit": 3, "description": "optimal is read + 2 edits (opencode discourages bash for file edits)"}, {"type": "file_regex", "path": "src/auth.ts", "pattern": "NEEDLE_updated", "should_match": true, "description": "first replacement applied"}, {"type": "file_regex", "path": "src/auth.ts", "pattern": "MARKER: updated", "should_match": true, "description": "second replacement applied"}]}
{"id": 7, "name": "create_file", "category": "efficiency", "project": "default", "contract": "completion", "surface": "tools", "min_calls": 1, "prompt": "Create a new file src/config.ts containing exactly: `export const DEBUG = true`. The file doesn't exist yet -- just create it.", "checks": [{"type": "any_tool_name", "equals": "write"}, {"type": "max_tool_count", "max": 1, "description": "exactly one tool call"}, {"type": "no_tool_name", "not_equals": "read"}, {"type": "no_tool_name", "not_equals": "glob"}, {"type": "tool_count_score", "optimal": 1, "limit": 1, "description": "optimal and maximum is 1 tool call"}, {"type": "file_regex", "path": "src/config.ts", "pattern": "^export const DEBUG = true\\s*$", "should_match": true, "description": "file contains exactly export const DEBUG = true"}]}
{"id": 8, "name": "direct_edit", "category": "efficiency", "project": "default", "contract": "completion", "surface": "tools", "min_calls": 2, "prompt": "In src/utils.ts, replace the exact string `abc123` with `xyz789`. Everything you need is in this message -- do it in a single step.", "checks": [{"type": "max_tool_count", "max": 2, "description": "at most 2 tool calls"}, {"type": "tool_count_score", "optimal": 2, "limit": 2, "description": "optimal is read + edit (opencode discourages bash for file edits)"}, {"type": "file_regex", "path": "src/utils.ts", "pattern": "xyz789", "should_match": true, "description": "file on disk contains new token value"}]}
{"id": 9, "name": "plan_mode_readonly", "category": "plan_mode", "project": "plan_default", "contract": "routing", "surface": "modes", "agent": "plan", "min_calls": 0, "prompt": "Create a detailed plan for refactoring src/auth.ts to use JWT-based authentication.", "checks": [{"type": "no_tool_name", "not_equals": "edit"}, {"type": "no_tool_name", "not_equals": "bash"}, {"type": "text_contains", "pattern": "(?i)jwt|token|auth", "description": "response discusses JWT, token, or auth"}]}
{"id": 10, "name": "custom_plan_prompt", "category": "plan_mode", "project": "custom_plan", "contract": "routing", "surface": "modes", "agent": "plan", "min_calls": 1, "prompt": "Analyze src/app.ts and suggest improvements.", "checks": [{"type": "text_contains", "pattern": "\\[PLANNER\\]", "description": "response has [PLANNER] prefix from custom plan agent prompt"}]}
{"id": 11, "name": "no_edit", "category": "plan_mode", "project": "plan_default", "contract": "completion", "surface": "modes", "agent": "plan", "min_calls": 1, "prompt": "Read src/utils.ts, then change the TOKEN value from \"abc123\" to \"xyz789\".", "checks": [{"type": "any_tool_name", "equals": "read"}, {"type": "no_tool_name", "not_equals": "edit"}, {"type": "no_tool_name", "not_equals": "bash"}, {"type": "text_contains", "pattern": "abc123|xyz789", "description": "discusses the change in text"}]}
{"id": 12, "name": "bash_pipe", "category": "prompt_tool_restriction", "project": "bash_only", "contract": "completion", "surface": "permissions", "min_calls": 1, "prompt": "Count how many .ts files exist in src/ and report the exact number.", "checks": [{"type": "any_tool_name", "equals": "bash"}, {"type": "no_tool_name", "not_equals": "glob"}, {"type": "any_tool_param_regex", "tool": "bash", "param": "command", "pattern": "\\|", "description": "uses a pipe in bash command"}, {"type": "any_tool_param_regex", "tool": "bash", "param": "command", "pattern": "(?=.*src)(?=.*\\.ts)", "description": "bash command references both src/ and .ts"}, {"type": "text_contains", "pattern": "3", "description": "reports correct count"}]}
{"id": 13, "name": "bash_read", "category": "prompt_tool_restriction", "project": "bash_only", "contract": "completion", "surface": "permissions", "min_calls": 1, "prompt": "What is the marker value in src/data.txt?", "checks": [{"type": "text_contains", "pattern": "k9f2m7p3", "description": "finds the correct marker"}]}
{"id": 14, "name": "bash_search", "category": "prompt_tool_restriction", "project": "bash_only", "contract": "completion", "surface": "permissions", "min_calls": 1, "prompt": "Which file in src/ contains the string NEEDLE_abc1?", "checks": [{"type": "any_tool_name", "equals": "bash"}, {"type": "no_tool_name", "not_equals": "grep"}, {"type": "no_tool_name", "not_equals": "read"}, {"type": "any_tool_param_regex", "tool": "bash", "param": "command", "pattern": "NEEDLE_abc1", "description": "bash command searches for the actual needle string"}, {"type": "text_contains", "pattern": "app\\.ts", "description": "identifies app.ts as the file"}]}
