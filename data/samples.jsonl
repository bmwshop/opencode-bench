{"id": 16, "name": "knowledge", "category": "skill", "project": "skill_knowledge", "contract": "completion", "surface": "skills", "min_calls": 3, "prompt": "Create an API handler for user registration in src/register.ts", "checks": [{"type": "any_tool_name", "equals": "skill"}, {"type": "any_tool_param_value", "tool": "skill", "param": "name", "equals": "api-style"}, {"type": "file_regex", "path": "register.ts", "pattern": "handle[A-Z]", "should_match": true, "description": "function has handle prefix"}, {"type": "file_regex", "path": "register.ts", "pattern": "API_HANDLER", "should_match": true, "description": "marker comment present"}, {"type": "file_regex", "path": "register.ts", "pattern": "ok\\s*:", "should_match": true, "description": "return object includes ok field"}, {"type": "tool_before", "first": "read", "then": "edit", "description": "read before edit (filetime.assert enforced)"}]}
{"id": 17, "name": "workflow", "category": "skill", "project": "skill_workflow", "contract": "completion", "surface": "skills", "min_calls": 4, "prompt": "Review src/app.ts", "checks": [{"type": "any_tool_name", "equals": "skill"}, {"type": "any_tool_param_value", "tool": "skill", "param": "name", "equals": "review-flow"}, {"type": "file_regex", "path": "review.md", "pattern": "# Review", "should_match": true, "description": "output file has correct heading"}, {"type": "file_regex", "path": "review.md", "pattern": "app\\.ts", "should_match": true, "description": "review mentions the target filename"}, {"type": "file_regex", "path": "review.md", "pattern": "TODO Count.*2", "should_match": true, "description": "review includes correct TODO count"}]}
