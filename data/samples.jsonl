{"id": 1, "name": "read", "category": "tool_schema", "project": "default", "prompt": "Read the file src/index.ts and tell me the marker value.", "checks": [{"type": "any_tool_name", "equals": "read"}, {"type": "any_tool_param_exists", "tool": "read", "param": "filePath"}, {"type": "any_tool_param_absent", "tool": "read", "param": "path"}, {"type": "text_contains", "pattern": "8f3a2b1c", "description": "response mentions the marker"}]}
{"id": 2, "name": "edit", "category": "tool_schema", "project": "default", "prompt": "In src/utils.ts, change the TOKEN value from \"abc123\" to \"xyz789\".", "checks": [{"type": "any_tool_name", "equals": "edit"}, {"type": "any_tool_param_exists", "tool": "edit", "param": "filePath"}, {"type": "any_tool_param_exists", "tool": "edit", "param": "oldString"}, {"type": "any_tool_param_exists", "tool": "edit", "param": "newString"}, {"type": "any_tool_param_absent", "tool": "edit", "param": "old_string"}, {"type": "any_tool_param_absent", "tool": "edit", "param": "new_string"}, {"type": "any_tool_param_regex", "tool": "edit", "param": "newString", "pattern": "xyz789", "description": "newString contains xyz789"}]}
{"id": 3, "name": "bash", "category": "tool_schema", "project": "default", "prompt": "Run the command: echo BENCH_OK", "checks": [{"type": "any_tool_name", "equals": "bash"}, {"type": "any_tool_param_exists", "tool": "bash", "param": "description"}, {"type": "any_tool_param_exists", "tool": "bash", "param": "command"}, {"type": "text_contains", "pattern": "BENCH_OK", "description": "output contains BENCH_OK"}]}
{"id": 4, "name": "write", "category": "tool_schema", "project": "default", "prompt": "Create a new file src/id.txt containing exactly: BENCH_7d4e", "checks": [{"type": "any_tool_name", "equals": "write"}, {"type": "any_tool_param_exists", "tool": "write", "param": "filePath"}, {"type": "any_tool_param_exists", "tool": "write", "param": "content"}, {"type": "any_tool_param_regex", "tool": "write", "param": "content", "pattern": "BENCH_7d4e", "description": "content contains the marker"}]}
{"id": 5, "name": "glob", "category": "tool_schema", "project": "default", "prompt": "Find all test files in this project.", "checks": [{"type": "any_tool_name", "equals": "glob"}, {"type": "no_tool_name", "not_equals": "bash"}]}
{"id": 6, "name": "grep", "category": "tool_schema", "project": "default", "prompt": "Find which file contains the string NEEDLE_f9c2.", "checks": [{"type": "any_tool_name", "equals": "grep"}, {"type": "no_tool_name", "not_equals": "bash"}, {"type": "text_contains", "pattern": "auth\\.ts", "description": "identifies auth.ts as the file"}]}
{"id": 7, "name": "sequential", "category": "tool_orchestration", "project": "default", "prompt": "Read src/utils.ts, then change the TOKEN value from \"abc123\" to \"xyz789\".", "checks": [{"type": "tool_before", "first": "read", "then": "edit", "description": "read before edit"}, {"type": "any_tool_param_regex", "tool": "edit", "param": "newString", "pattern": "xyz789", "description": "newString contains xyz789"}]}
{"id": 8, "name": "parallel", "category": "tool_orchestration", "project": "default", "prompt": "Read both src/index.ts and src/auth.ts at the same time and tell me both marker values.", "checks": [{"type": "min_tool_count", "name": "read", "min": 2}, {"type": "tools_same_step", "tool": "read", "min": 2, "description": "both reads in same step"}, {"type": "text_contains", "pattern": "8f3a2b1c", "description": "response mentions index.ts marker"}, {"type": "text_contains", "pattern": "b7e1d930", "description": "response mentions auth.ts marker"}]}
{"id": 9, "name": "explore", "category": "subagent", "project": "multi_module", "prompt": "Explore the authentication system in packages/auth/ and give me a comprehensive summary of how login, tokens, sessions, and middleware work together.", "checks": [{"type": "any_tool_name", "equals": "task"}, {"type": "any_tool_param_value", "tool": "task", "param": "subagent_type", "equals": "explore"}]}
{"id": 10, "name": "general", "category": "subagent", "project": "multi_module", "prompt": "Every file in packages/payment/src/ uses double quotes for strings. Delegate a task to refactor all payment source files to use single quotes instead.", "checks": [{"type": "any_tool_name", "equals": "task"}, {"type": "any_tool_param_value", "tool": "task", "param": "subagent_type", "equals": "general"}]}
{"id": 11, "name": "parallel", "category": "subagent", "project": "multi_module", "prompt": "I need two independent investigations done simultaneously: (1) explore the authentication system in packages/auth/, and (2) explore the payment processing pipeline in packages/payment/. Do both at the same time.", "checks": [{"type": "min_tool_count", "name": "task", "min": 2}, {"type": "tools_same_step", "tool": "task", "min": 2, "description": "both tasks spawned in same step"}]}
{"id": 12, "name": "custom_subagent", "category": "subagent", "project": "custom_subagent", "prompt": "I just rewrote src/payment.ts. Please review it for issues.", "checks": [{"type": "any_tool_name", "equals": "task"}, {"type": "any_tool_param_value", "tool": "task", "param": "subagent_type", "equals": "reviewer"}]}
{"id": 13, "name": "camel_case", "category": "agents_md", "project": "camel_case", "prompt": "Write a function that converts Fahrenheit to Celsius. Write it to src/convert.py", "checks": [{"type": "file_regex", "path": "src/convert.py", "pattern": "def\\s+[a-z]+[A-Z]\\w*\\(", "should_match": true, "description": "function name is camelCase (e.g. fahrenheitToCelsius)"}, {"type": "file_regex", "path": "src/convert.py", "pattern": "def\\s+[a-z]+_[a-z]", "should_match": false, "description": "no snake_case function names"}]}
{"id": 14, "name": "custom_main_agent", "category": "agents_md", "project": "custom_main_agent", "agent": "auditor", "prompt": "Review src/app.ts for security issues.", "checks": [{"type": "text_contains", "pattern": "\\[AUDITOR\\]", "description": "response has [AUDITOR] prefix from custom agent prompt"}]}
{"id": 15, "name": "no_edit", "category": "plan_mode", "project": "plan_default", "agent": "plan", "prompt": "Read src/utils.ts, then change the TOKEN value from \"abc123\" to \"xyz789\".", "checks": [{"type": "any_tool_name", "equals": "read"}, {"type": "no_tool_name", "not_equals": "edit"}, {"type": "text_contains", "pattern": "abc123|xyz789", "description": "discusses the change in text"}]}
{"id": 16, "name": "creates_plan_file", "category": "plan_mode", "project": "plan_default", "agent": "plan", "prompt": "Create a detailed plan for refactoring src/auth.ts to use JWT-based authentication.", "checks": [{"type": "any_tool_name", "equals": "edit"}, {"type": "any_tool_param_regex", "tool": "edit", "param": "filePath", "pattern": "plans/.*\\.md", "description": "edit targets a plan file path"}, {"type": "no_tool_name", "not_equals": "write"}]}
{"id": 17, "name": "custom_plan_prompt", "category": "plan_mode", "project": "custom_plan", "agent": "plan", "prompt": "Analyze src/app.ts and suggest improvements.", "checks": [{"type": "text_contains", "pattern": "\\[PLANNER\\]", "description": "response has [PLANNER] prefix from custom plan agent prompt"}]}
{"id": 18, "name": "bash_read", "category": "prompt_tool_restriction", "project": "bash_only", "agent": "bash_only", "prompt": "What is the marker value in src/data.txt?", "checks": [{"type": "any_tool_name", "equals": "bash"}, {"type": "no_tool_name", "not_equals": "read"}, {"type": "text_contains", "pattern": "k9f2m7p3", "description": "finds the correct marker"}]}
{"id": 19, "name": "bash_search", "category": "prompt_tool_restriction", "project": "bash_only", "agent": "bash_only", "prompt": "Which file in src/ contains the string NEEDLE_abc1?", "checks": [{"type": "any_tool_name", "equals": "bash"}, {"type": "no_tool_name", "not_equals": "grep"}, {"type": "no_tool_name", "not_equals": "read"}, {"type": "text_contains", "pattern": "app\\.ts", "description": "identifies app.ts as the file"}]}
{"id": 20, "name": "bash_pipe", "category": "prompt_tool_restriction", "project": "bash_only", "agent": "bash_only", "prompt": "Count how many .ts files exist in src/ and report the exact number.", "checks": [{"type": "any_tool_name", "equals": "bash"}, {"type": "no_tool_name", "not_equals": "glob"}, {"type": "any_tool_param_regex", "tool": "bash", "param": "command", "pattern": "\\|", "description": "uses a pipe in bash command"}, {"type": "text_contains", "pattern": "3", "description": "reports correct count"}]}
{"id": 21, "name": "bash_strict", "category": "system_tool_restriction", "project": "bash_strict", "agent": "bash_strict", "prompt": "Which file in src/ contains the string NEEDLE_abc1?", "checks": [{"type": "any_tool_name", "equals": "bash"}, {"type": "no_tool_name", "not_equals": "read"}, {"type": "no_tool_name", "not_equals": "grep"}, {"type": "no_tool_name", "not_equals": "glob"}, {"type": "text_contains", "pattern": "app\\.ts", "description": "identifies app.ts as the file"}]}
{"id": 22, "name": "knowledge", "category": "skill", "project": "skill_knowledge", "prompt": "Create an API handler for user registration in src/register.ts", "checks": [{"type": "any_tool_name", "equals": "skill"}, {"type": "any_tool_param_value", "tool": "skill", "param": "name", "equals": "api-style"}, {"type": "file_regex", "path": "register.ts", "pattern": "handle[A-Z]", "should_match": true, "description": "function has handle prefix"}, {"type": "file_regex", "path": "register.ts", "pattern": "API_HANDLER", "should_match": true, "description": "marker comment present"}]}
{"id": 23, "name": "workflow", "category": "skill", "project": "skill_workflow", "prompt": "Review src/app.ts", "checks": [{"type": "any_tool_name", "equals": "skill"}, {"type": "tool_before", "first": "read", "then": "bash", "description": "read file before running grep"}, {"type": "file_regex", "path": "review.md", "pattern": "# Review", "should_match": true, "description": "output file has correct heading"}]}
{"id": 24, "name": "code_backed", "category": "skill", "project": "skill_code", "prompt": "Validate the project.", "checks": [{"type": "any_tool_name", "equals": "skill"}, {"type": "any_tool_name", "equals": "bash"}, {"type": "text_contains", "pattern": "VALID_x7k2m9", "description": "reported the validation code"}]}
