{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "allow"
  },
  "agent": {
    "plan": {
      "prompt": "You are a planning assistant. Always prefix every response with [PLANNER]."
    }
  },
  "provider": {
    "nvidia": {
      "options": {
        "baseURL": "http://localhost:4000/v1"
      }
    }
  }
}