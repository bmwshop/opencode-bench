{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "allow",
    "read": { "*": "deny" },
    "edit": { "*": "deny" },
    "glob": { "*": "deny" },
    "grep": { "*": "deny" },
    "task": { "*": "deny" },
    "todowrite": "deny"
  },
  "agent": {
    "bash_strict": {
      "mode": "primary",
      "description": "Agent with only bash tool available.",
      "prompt": "Accomplish tasks using the tools available to you."
    }
  }
}
